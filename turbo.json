{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "DATABASE_URL",
    "ELASTICSEARCH_URL",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "IMAGEKIT_PUBLIC_KEY",
    "IMAGEKIT_PRIVATE_KEY",
    "IMAGEKIT_URL_ENDPOINT",
    "RAZORPAY_KEY_ID",
    "RAZORPAY_KEY_SECRET",
    "SMTP_HOST",
    "SMTP_USER",
    "REDIS_URL"
  ],
  "globalPassThroughEnv": [
    "MONGODB_URI",
    "MONGODB_SERVER_SELECTION_TIMEOUT_MS",
    "MONGODB_CONNECT_TIMEOUT_MS",
    "MONGODB_MAX_RETRIES",
    "AUTH_DB_NAME",
    "USER_DB_NAME",
    "PRODUCT_DB_NAME",
    "SEARCH_DB_NAME",
    "CART_DB_NAME",
    "ORDER_DB_NAME",
    "PAYMENT_DB_NAME",
    "INVOICE_DB_NAME",
    "INVENTORY_DB_NAME",
    "NOTIFICATION_DB_NAME",
    "API_GATEWAY_PORT",
    "AUTH_SERVICE_PORT",
    "USER_SERVICE_PORT",
    "PRODUCT_SERVICE_PORT",
    "SEARCH_SERVICE_PORT",
    "CART_SERVICE_PORT",
    "ORDER_SERVICE_PORT",
    "PAYMENT_SERVICE_PORT",
    "INVOICE_SERVICE_PORT",
    "INVENTORY_SERVICE_PORT",
    "NOTIFICATION_SERVICE_PORT",
    "WEB_PORT",
    "ADMIN_PORT",
    "AUTH_SERVICE_URL",
    "USER_SERVICE_URL",
    "PRODUCT_SERVICE_URL",
    "SEARCH_SERVICE_URL",
    "CART_SERVICE_URL",
    "ORDER_SERVICE_URL",
    "PAYMENT_SERVICE_URL",
    "INVOICE_SERVICE_URL",
    "INVENTORY_SERVICE_URL",
    "NOTIFICATION_SERVICE_URL",
    "API_GATEWAY_URL",
    "JWT_ACCESS_EXPIRY",
    "JWT_REFRESH_EXPIRY",
    "COOKIE_DOMAIN",
    "COOKIE_SECURE",
    "INVOICE_PREFIX",
    "INVOICE_START_NUMBER",
    "CURRENCY_CODE",
    "CURRENCY_SYMBOL",
    "CURRENCY_SMALLEST_UNIT",
    "LOG_LEVEL",
    "BCRYPT_ROUNDS",
    "RAZORPAY_WEBHOOK_SECRET",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_PASS",
    "EMAIL_FROM",
    "ALLOWED_ORIGINS",
    "RATE_LIMIT_MAX",
    "RATE_LIMIT_WINDOW_MS",
    "SELLER_NAME",
    "SELLER_ADDRESS",
    "SELLER_GSTIN",
    "SELLER_PHONE",
    "SELLER_EMAIL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "format": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "setup:admin": {
      "cache": false
    }
  }
}
