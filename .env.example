# ===========================
# ornate - Environment Template
# Copy to .env and fill in values
# NEVER commit the actual .env file
# ===========================

# ---- Application ----
NODE_ENV=development

# ---- Service Ports ----
API_GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4001
USER_SERVICE_PORT=4002
PRODUCT_SERVICE_PORT=4003
SEARCH_SERVICE_PORT=4004
CART_SERVICE_PORT=4005
ORDER_SERVICE_PORT=4006
PAYMENT_SERVICE_PORT=4007
INVOICE_SERVICE_PORT=4008
INVENTORY_SERVICE_PORT=4009
NOTIFICATION_SERVICE_PORT=4010
WEB_PORT=5173
ADMIN_PORT=5174

# ---- Internal Service URLs (used by gateway + inter-service calls) ----
AUTH_SERVICE_URL=http://localhost:4001
USER_SERVICE_URL=http://localhost:4002
PRODUCT_SERVICE_URL=http://localhost:4003
SEARCH_SERVICE_URL=http://localhost:4004
CART_SERVICE_URL=http://localhost:4005
ORDER_SERVICE_URL=http://localhost:4006
PAYMENT_SERVICE_URL=http://localhost:4007
INVOICE_SERVICE_URL=http://localhost:4008
INVENTORY_SERVICE_URL=http://localhost:4009
NOTIFICATION_SERVICE_URL=http://localhost:4010

# ---- MongoDB ----
# Each service uses its own database in the same cluster
MONGODB_URI=mongodb://localhost:27017
AUTH_DB_NAME=ornate_auth
USER_DB_NAME=ornate_users
PRODUCT_DB_NAME=ornate_products
SEARCH_DB_NAME=ornate_search
CART_DB_NAME=ornate_cart
ORDER_DB_NAME=ornate_orders
PAYMENT_DB_NAME=ornate_payments
INVOICE_DB_NAME=ornate_invoices
INVENTORY_DB_NAME=ornate_inventory
NOTIFICATION_DB_NAME=ornate_notifications

# ---- Elasticsearch ----
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_PRODUCTS_INDEX=ornate_products

# ---- JWT ----
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- Cookies ----
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---- ImageKit ----
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ---- Razorpay ----
# Use test keys for development: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ---- SMTP / Email ----
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@ornate.dev

# ---- Redis (optional: for rate-limiting, session, queues) ----
REDIS_URL=redis://localhost:6379

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ---- Store / Seller Details (configure before production) ----
SELLER_NAME=ornate Store
SELLER_ADDRESS=123 Sample Street, City, State, 000000
SELLER_GSTIN=CONFIGURE_BEFORE_PRODUCTION
SELLER_EMAIL=store@ornate.dev
SELLER_PHONE=+91-0000000000

# ---- Invoice ----
INVOICE_PREFIX=INV
INVOICE_START_NUMBER=1000

# ---- Currency ----
# Stored as smallest unit (paise for INR)
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹
CURRENCY_SMALLEST_UNIT=100

# ---- Misc ----
LOG_LEVEL=info
BCRYPT_ROUNDS=12
