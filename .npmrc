# Ensure peer dependencies are auto-installed
auto-install-peers=true

# Keep local workspace packages linked
link-workspace-packages=true

# Ensure devDependencies (typescript, vite, turbo, etc.) are always installed on Vercel even if NODE_ENV=production
production=false

# Hoist all dependencies to root node_modules for seamless IDE/VS Code TypeScript resolution
shamefully-hoist=true
public-hoist-pattern[]=*typescript*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*turbo*
public-hoist-pattern[]=*vite*
public-hoist-pattern[]=*@types*
